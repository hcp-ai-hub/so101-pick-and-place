#!/usr/bin/env bash
# ============================================================
# so101-aist 学習用設定
# config.common.env に加えて、08/09/11/12/13番のスクリプトと
# tools/checkpoint_hub_gc.sh がこのファイルを source します
# （学習・推論・チェックポイント管理に関する設定）。
# ============================================================

# 学習済みポリシーは既定で Public にアップロードします
# （08/11/13番の lerobot-train の --policy.private に渡ります）。
# データセット側の公開範囲は config.collect.env の HF_PRIVATE（既定 true = Private）
# で別に制御します — データセットは非公開のまま、学習済みモデルだけ公開する運用です。
# 学習済みモデルもPrivateにしたい場合はここを "true" にしてください。
export HF_PRIVATE="false"

# --- 学習 / 推論設定（ACT/pi0トラック） --------------------------------
export POLICY_TYPE="act"
export POLICY_DEVICE="auto"  # auto: 08_train_policy.sh が torch.cuda.is_available() で cuda/cpu を自動判定します。
                              # 明示指定したい場合は cuda / cpu / mps などを直接書いてください。
export POLICY_REPO_ID="${HF_USER}/my_so101_policy_v2"
export OUTPUT_DIR="outputs/train/act_so101_test"
export JOB_NAME="act_so101_test"

# Weights & Biases でログを見るかどうか（08_train_policy.sh の --wandb.enable に渡されます）。
export WANDB_ENABLE="true"

# wandb の認証用 API key（https://wandb.ai/authorize から取得）。
# ユーザー要望により config.train.env に直接記載し、Gitで複数マシン間を同期しています
# （config.train.env はこのため Public にしないこと。GitHub上のリポジトリもPrivateのまま維持してください）。
export WANDB_API_KEY="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"

# --- GR00T N1.7 (NVIDIA) 設定 (10〜12番のスクリプトで使用) ------------------
# ACT/pi0系 (POLICY_TYPE, 08/09番台) とは別トラックの学習・推論設定です。
# 参考: https://huggingface.co/blog/nvidia/nvidia-isaac-teleop-and-gr00t17-in-lerobot
export GROOT_BASE_MODEL_PATH="nvidia/GR00T-N1.7-3B"
export GROOT_EMBODIMENT_TAG="new_embodiment"
export GROOT_REPO_ID="${HF_USER}/my_so101_groot_policy_v2"
export GROOT_OUTPUT_DIR="outputs/train/groot_so101"
export GROOT_JOB_NAME="groot_so101"
export GROOT_CHUNK_SIZE=16
export GROOT_TRAIN_N_ACTION_STEPS=16
export GROOT_ROLLOUT_N_ACTION_STEPS=8
export GROOT_BATCH_SIZE=64
export GROOT_STEPS=100000
export GROOT_SAVE_FREQ=5000
export GROOT_RELATIVE_EXCLUDE_JOINTS='["gripper"]'
# Weights & Biases でログを見るかどうか（11_train_policy_groot.sh の --wandb.enable に渡されます）。
export GROOT_WANDB_ENABLE=true

# --- GR00T 複数GPU学習 (13_train_policy_groot_multi_gpu.sh 専用) ------------------
# 空文字のままなら nvidia-smi で検出できるGPU枚数を自動で使う。使うGPU枚数を絞りたい
# 場合はここに数値を指定するか、実行時に CUDA_VISIBLE_DEVICES=0,1 のように渡してください。
export GROOT_NUM_GPUS=""

# accelerate launch の --mixed_precision に渡す値。GR00Tポリシー自体が
# --policy.use_bf16=true で独自にbf16キャストを行うため、既定は "no"（accelerate側では
# 追加のキャストをしない）。accelerate側の機構で混合精度をかけたい場合のみ "bf16"/"fp16" に。
export GROOT_MULTI_GPU_MIXED_PRECISION="no"

# --- チェックポイントの保存先 (ローカル / Hub) ----------------------------------
# true にすると、学習中に作成される各チェックポイント（最終モデルだけでなく
# 学習途中の save_freq ごとのもの）も、逐次 Hub の POLICY_REPO_ID / GROOT_REPO_ID に
# アップロードします（lerobot-train の --save_checkpoint_to_hub）。
# 08/11番スクリプトはこの値を両方の学習トラックに渡します。
export SAVE_CHECKPOINT_TO_HUB="true"

# true にすると、上記でHubへのアップロードが確認できたローカルのチェックポイント
# ディレクトリを、学習と並行して自動削除します（tools/checkpoint_hub_gc.py、既定で
# ポーリング間隔60秒）。実質的に「チェックポイントはHubにのみ保存」される状態になります。
# SAVE_CHECKPOINT_TO_HUB="false" のときはこの値に関わらず何もしません
# （ローカルにしかチェックポイントが無いのに削除すると復元できなくなるため）。
#
# 注意: この設定で学習を再開する場合、ローカルの checkpoints/last には
# 完全なチェックポイントが残っていない前提になるため、Hub上のリポジトリを直接
# 指定して再開してください:
#   lerobot-train --config_path=<HF_USER>/<policy_repo_id> --resume=true
export CHECKPOINT_LOCAL_CLEANUP="true"

# tools/checkpoint_hub_gc.py のポーリング間隔（秒）
export CHECKPOINT_GC_INTERVAL=60
