#!/usr/bin/env bash
# ============================================================
# so101-aist インタラクティブ推論用設定
# 02_train/16_interactive_rollout.sh がこのファイルを source します。
# config.common.env / config.train.env と合わせて source する前提です
# （POLICY_REPO_ID / GROOT_REPO_ID 等の学習済みポリシーの場所は
#  config.train.env 側にあります。このファイルはインタラクティブ実行
#  固有の設定だけを持ちます）。
# ============================================================

# 起動時のデフォルトポリシートラック。"act"（08/09番, ACT/pi0系）か
# "groot"（11/12番, GR00T N1.7系）のいずれかを指定してください。
#
# 実行時に第1引数で上書きできます: ./02_train/16_interactive_rollout.sh groot
# ループに入った後も `track act` / `track groot` と入力すればいつでも
# 切り替えられます（プロセスは再起動されず、次に実行するタスクから反映されます）。
export INTERACTIVE_POLICY_TRACK="act"

# 各プロンプト実行時のデフォルト動作時間（秒）。ループ中は空Enterでこの値を使い、
# 数値を入力すればその回だけ上書きできます（次回以降は入力した値が新しい既定値になります）。
export INTERACTIVE_DEFAULT_DURATION="30"

# track=act のとき使うポリシーパス。空欄なら config.train.env の POLICY_REPO_ID を使います。
# ローカルチェックポイント（例: outputs/train/act_so101_test/checkpoints/last/pretrained_model）
# を試したい場合はここにパスを書いてください。
export INTERACTIVE_ACT_POLICY_PATH=""

# track=groot のとき使うポリシーパス。空欄なら config.train.env の GROOT_REPO_ID を使います。
# 12_rollout_inference_groot.sh の第2引数と同様、ローカルチェックポイントも指定できます。
export INTERACTIVE_GROOT_POLICY_PATH=""
