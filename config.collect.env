#!/usr/bin/env bash
# ============================================================
# so101-aist データ収集用設定
# config.common.env に加えて、06_record_dataset.sh と
# 15_convert_raw_to_dataset.sh がこのファイルを source します
# （収集したデータセットの Hub 公開範囲など、収集時にだけ関係する設定）。
# ============================================================

# 収集したデータセットは既定で Private にアップロードします
# （06番の lerobot-record の --dataset.private、15番の push_to_hub に渡ります）。
# 学習済みポリシーの公開範囲は config.train.env の HF_PRIVATE（既定 false = Public）
# で別に制御します — データセットは非公開のまま、学習済みモデルだけ公開する運用です。
# Publicにしたい場合はここを "false" にしてください。
export HF_PRIVATE="true"

# --- データ収集パラメータ (06_record_dataset.sh) -------------------------
export NUM_EPISODES=50
export EPISODE_TIME_S=60
export RESET_TIME_S=60
