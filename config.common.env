#!/usr/bin/env bash
# ============================================================
# so101-aist 共通設定ファイル（データ収集・学習のどちらでも使う設定）
# 各スクリプトはこのファイルを `source` して変数を読み込みます。
# ご自身の環境に合わせて値を書き換えてください。
#
# データ収集固有の設定（HF_PRIVATE=true 等）は config.collect.env、
# 学習固有の設定（HF_PRIVATE=false, POLICY_*, GROOT_* 等）は config.train.env
# にあります。どちらも source する前に、この config.common.env を先に
# source してください（HF_USER など、他ファイルの値の組み立てに使う変数が
# こちらにあるため）。
# ============================================================

# --- USB ポート -------------------------------------------------
# 01_find_port.sh を実行して調べたポート名を入れてください
export FOLLOWER_PORT="/dev/ttyACM1"
export LEADER_PORT="/dev/ttyACM0"

# --- アームの識別名（キャリブレーションファイル名になります） -----
export FOLLOWER_ID="my_awesome_follower_arm"
export LEADER_ID="my_awesome_leader_arm"

# --- Hugging Face -------------------------------------------------
# `hf auth login` 後に `hf auth whoami` で確認できるユーザー名
export HF_USER="taniguchitakara"

# --- データセット / タスク設定 -------------------------------------
# データ収集（06/14/15番）が作成し、学習（08/11/13番）が読み込む、収集と
# 学習の橋渡しとなる設定なのでここに置いています。
export DATASET_REPO_ID="${HF_USER}/so101-dataset-v2"
export TASK_DESCRIPTION="Pick up the orange and place it in the target location."

# --- カメラ設定 -----------------------------------------------------
# 参考: https://huggingface.co/docs/lerobot/cameras , docs/CAMERA_SETUP.md
# 2026-09-02: 以前の /dev/video0 (1344x376) はデュアルレンズのステレオ/3D webカメラの
# 合成SBSストリームだったことが判明（同じ映像が左右に並んで映る不具合の原因）。
# カメラの設定/配線を見直した結果、lerobot-find-cameras opencv で /dev/video2, /dev/video4,
# /dev/video6 の3つの単眼ストリーム(各640x480 YUYV/UYVY, 30fps)が見つかったため、
# front=/dev/video2（外部カメラ）, wrist=/dev/video6（手首カメラ）の2台構成（2026-09-09に
# video2/video6を入れ替え。/dev/video4は未使用）。
# index_or_path は lerobot-find-cameras opencv で調べた値です（Linuxでは /dev/videoN の
# デバイスパス形式で出てくることが多く、そのまま使えます）。
#
# 注意: 2026-09-01時点でお使いのLeRobotのバージョンには OpenCVCameraConfig の `backend`
# フィールドが無い（指定すると "unexpected field" エラーになる）ため backend は指定しない。
# `fourcc` も明示指定はしていない — 以前 `fourcc: MJPG` を試した際に設定失敗する既知の不具合
# (https://github.com/huggingface/lerobot/issues/3198 と同種の症状、V4L2バックエンドの
# fourcc/width/height設定がFFMPEG経由だと効かないケース) に当たったため、
# width/heightをカメラのネイティブ値(640x480)に合わせた上でfourccはカメラのデフォルト
# (video2/video6ともにYUYV) に任せている。
export CAMERA_CONFIG='{ front: {type: opencv, index_or_path: /dev/video2, width: 640, height: 480, fps: 30}, wrist: {type: opencv, index_or_path: /dev/video6, width: 640, height: 480, fps: 15, warmup_s: 3} }'

# --- 生データ収集 (14_record_dataset_raw.sh / 15_convert_raw_to_dataset.sh) 用の設定 ---
# lerobot-record を使わず、カメラを1台ずつ間隔を空けて接続する自前スクリプト用。
# RealSenseとOpenCVカメラを同時接続するとwristカメラがtimeoutする問題
# (docs/CAMERA_SETUP.md参照)を回避するための代替パス。
#
# RAW_CAMERAS は CAMERA_CONFIG と同じ内容をJSON配列で書いたもの（自前スクリプトで
# json.loads するため、lerobotの緩い辞書構文ではなく厳密なJSON構文にしています）。
# RealSenseを使う場合は type を "intelrealsense" にし、index_or_path の代わりに
# serial_number_or_name を指定してください（docs/CAMERA_SETUP.mdのTODO参照）。
export RAW_CAMERAS='[{"name": "front", "type": "opencv", "index_or_path": "/dev/video2", "width": 640, "height": 480, "fps": 30}, {"name": "wrist", "type": "opencv", "index_or_path": "/dev/video6", "width": 640, "height": 480, "fps": 15}]'

# 録画データの保存先ディレクトリ（このディレクトリ以下に日時付きセッションフォルダができます）
export RAW_RECORD_DIR="raw_recordings"

# 録画のループ周波数（Hz）
export RAW_RECORD_FPS="30"

# カメラ接続のリトライ回数・リトライ間隔（秒）。1台ずつこの間隔を空けて接続します。
export RAW_CAMERA_CONNECT_RETRY="3"
export RAW_CAMERA_CONNECT_DELAY_S="2"

# --- 映像プレビュー (rerun) 設定 --------------------------------------
# 05/06/12 番のスクリプトは --display_data でカメラ映像をリアルタイム表示できますが、
# これは rerun というGUIビューアを起動するため、実機マシンにディスプレイ（X11/Wayland）
# が無い状態（SSHでログインしているだけ等）だと
# "nor wayland socket nor display is set" のようなエラーで失敗します。
# 実機に直接モニタを繋いでいる/VNC等でデスクトップに繋いでいる場合のみ true にしてください。
export DISPLAY_DATA="false"
